rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc dữ liệu học sinh công khai để phụ huynh tra cứu qua link báo cáo
    // Cho phép giáo viên cập nhật và lưu điểm trên bảng điều khiển
    match /students/{studentId} {
      allow read, write: if true;
    }
  }
}
